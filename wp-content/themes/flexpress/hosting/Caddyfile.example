# Portable example; substitute every placeholder before validating.
# Requires Caddy 2.11+ and dns.providers.cloudflare; read ../HOSTING.md.
# Cloudflare ranges fetched from https://api.cloudflare.com/client/v4/ips on 2026-11-07.
# This example ships as documentation. Install the rendered config outside the web root.
(__SITE_ID__-cloudflare-ranges) {
	remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
}

(__SITE_ID__-allowed-peers) {
	remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 127.0.0.1/32 ::1/128
}

(__SITE_ID__-cloudflare-boundary) {
	# Loopback is for checks run over SSH; no LAN/public origin bypass.
	@outsideEdge {
		not {
			import __SITE_ID__-allowed-peers
		}
	}
	respond @outsideEdge "Access through Cloudflare is required." 403

	@notCloudflare {
		not {
			import __SITE_ID__-cloudflare-ranges
		}
	}
	# Local checks must never be able to spoof Cloudflare's visitor headers.
	request_header @notCloudflare -CF-Connecting-IP
	request_header @notCloudflare -CF-IPCountry

	# DNS challenges continue working when direct public HTTP is denied.
	tls {
		dns cloudflare {env.__TOKEN_ENV__}
	}
}

__DOMAIN__ {
	import __SITE_ID__-cloudflare-boundary
	# Cloudflare sets this header; the boundary verifies the connecting peer.
	map {http.request.header.CF-Connecting-IP} {__SITE_ID___client_ip} {
		"" {http.request.remote.host}
		default {http.request.header.CF-Connecting-IP}
	}
	# Avoid Apache's HTTP directory-slash redirect behind TLS termination.
	@adminSlash {
		path /wp-admin
		import __SITE_ID__-allowed-peers
	}
	redir @adminSlash https://__DOMAIN__/wp-admin/ 308

	reverse_proxy __UPSTREAM__ {
		header_up Host {host}
		header_up X-Real-IP {__SITE_ID___client_ip}
		header_up X-Forwarded-For {__SITE_ID___client_ip}
		header_up X-Forwarded-Proto {scheme}

		# Override origin caching for dynamic pages, redirects, errors, and API responses.
		header_down Cache-Control "private, no-store, max-age=0"
		header_down Expires "0"
		header_down Pragma "no-cache"
		header_down -Age
		header_down -X-Cache-Enabled
		header_down -X-Cache-Status

		# Both response MIME type and request path must qualify for public caching.
		@staticResponse {
			status 200 206
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type image/*
			header Content-Type font/*
			header Content-Type application/font-*
			header Content-Type application/vnd.ms-fontobject*
			header !Set-Cookie
		}
		handle_response @staticResponse {
			header @publicAsset {
				Cache-Control "public, max-age=86400"
				-Expires
				-Pragma
			}
			copy_response
		}

		# Increase timeouts for cold starts
		transport http {
			dial_timeout 30s
			response_header_timeout 60s
			expect_continue_timeout 10s
			keepalive 90s
			keepalive_idle_conns 10
		}
	}

	# Both the request and actual response must identify a public static asset.
	# A missing .css URL that returns WordPress HTML must never acquire a long TTL.
	@publicAsset {
		method GET HEAD
		path /wp-content/* /wp-includes/*
		path_regexp assetExtension \.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot)$
		not header_regexp AssetLogin Cookie (wordpress_logged_in_|wordpress_sec_)
		not header Authorization *
	}
	# Enable gzip compression for all compressible content types
	# Caddy automatically compresses: text/html, text/css, text/javascript,
	# application/javascript, application/json, text/xml, application/xml, image/svg+xml
	encode gzip

	# Security headers
	header {
		# Security headers
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		-X-XSS-Protection
		Referrer-Policy "strict-origin-when-cross-origin"

		# Remove server signature
		-Server
	}

	# Logging
	log {
		output file __ACCESS_LOG__ {
			mode 0600
			roll_size 25MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" ""
				request>headers>Referer delete
				resp_headers>Location delete
			}
		}
	}
}

# Redirect www to non-www
www.__DOMAIN__ {
	import __SITE_ID__-cloudflare-boundary
	@allowed {
		import __SITE_ID__-allowed-peers
	}
	redir @allowed https://__DOMAIN__{uri} permanent
}
